# 运行数据（含用户数据），绝不提交
data/
*.db
*.db-*
*.db.bak*

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# 上架与运营材料：只公开清单、插件包和图标，其余（私钥、审核账号、内部运营文案）不进仓库
launch/*
!launch/server.json
!launch/openai-plugin/
!launch/icon-256.png
!launch/icon-512.png
!launch/icon-1024.png
launch/openai-plugin/*.zip

